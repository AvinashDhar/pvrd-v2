# Local Docker: mysql://pvrd:pvrd@localhost:3306/pvrd
# Hostinger: mysql://USER:PASSWORD@localhost:3306/DATABASE
# URL-encode any special characters in the password.
DATABASE_URL=mysql://pvrd:pvrd@localhost:3306/pvrd
ADMIN_EMAIL=admin@ompvrd.com
ADMIN_PASSWORD=
# Cloudflare R2. Required in production. Leave blank locally to store uploads in public/uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
